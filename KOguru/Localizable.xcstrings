    "Você irá praticar os golpes jab e direto, trabalhando precisão e técnica. Seus golpes serão identificados e analisados." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du übst den Jab und den Cross, arbeitest an Präzision und Technik. Deine Schläge werden erkannt und analysiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will practice the jab and cross punches, working precision and technique. Your punches will be identified and analyzed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practicarás los golpes Jab y Direto, trabajando precisión y técnica. Tus golpes serán identificados y analizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você irá praticar os golpes jab e direto, trabalhando precisão e técnica. Seus golpes serão identificados e analisados."
          }
        }
