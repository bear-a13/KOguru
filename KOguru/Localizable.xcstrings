    "A câmera usa pose 2D, então a velocidade é relativa ao seu corpo e é informada em m/s." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera verwendet 2D-Pose, daher ist die Geschwindigkeit relativ zu deinem Körper und wird in m/s angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera uses 2D pose, so speed is relative to your body and is shown in m/s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara usa pose 2D, así que la velocidad es relativa a tu cuerpo y se muestra en m/s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera usa pose 2D, então a velocidade é relativa ao seu corpo e é informada em m/s."
          }
        }
      }
    },
